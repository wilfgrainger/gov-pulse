{
  "version": 1,
  "note": "Non-feed routes only. /section/<slug>/ and /data/sections/<id>.{json,csv} are derived from the feed catalogue, /measure/<id>/ from measure-definitions.json and /sources/<id>/ from the publication config, all in contracts/route-manifest.js. [param] segments match one path segment. capability names an entry in config/product-capabilities.json that must also be available. feeds gate the route; evidence adds the further feeds a page renders (a list, or \"all\" for every published feed). app/lib/routeEvidence.js reads both for per-page snapshot projection and the edition manifest.",
  "routes": [
    { "path": "/", "kind": "static", "feeds": [], "evidence": ["employmentStats", "governmentContracts", "housePriceIndex", "nationalDebt", "nhsStats", "sentimentPulse", "taxRevenue"], "gate": "product", "capability": "home" },
    { "path": "/explore/", "kind": "static", "feeds": [], "evidence": "all", "gate": "product", "capability": "explore" },
    { "path": "/measure/", "kind": "static", "feeds": [], "evidence": "all", "gate": "product", "capability": "measureLibrary" },
    { "path": "/compare/", "kind": "static", "feeds": [], "evidence": "all", "gate": "product", "capability": "compare" },
    { "path": "/briefing/", "kind": "static", "feeds": [], "evidence": "all", "gate": "product", "capability": "briefing" },
    { "path": "/cost-of-living/", "kind": "static", "feeds": [], "evidence": ["housePriceIndex", "realWages", "sentimentPulse"], "gate": "product", "capability": "costOfLiving" },
    { "path": "/sources/", "kind": "static", "feeds": [], "gate": "product", "capability": "sources" },
    { "path": "/calendar/", "kind": "evidence", "feeds": ["releaseCalendar", "nhsReleaseCalendar"], "evidence": "all", "gate": "any-published", "capability": "calendar" },
    { "path": "/money/", "kind": "evidence", "feeds": ["governmentContracts"], "gate": "any-published", "capability": "publicMoney" },
    { "path": "/money/buyer/[id]/", "kind": "evidence", "feeds": ["governmentContracts"], "gate": "any-published", "capability": "publicMoney" },
    { "path": "/money/supplier/[id]/", "kind": "evidence", "feeds": ["governmentContracts"], "gate": "any-published", "capability": "publicMoney" },
    { "path": "/editions/", "kind": "evidence", "feeds": ["editionArchive"], "gate": "any-published", "capability": "editionArchive" },
    { "path": "/editions/[id]/", "kind": "evidence", "feeds": ["editionArchive"], "gate": "any-published", "capability": "editionArchive" },
    { "path": "/stories/household-budgets/", "kind": "evidence", "feeds": ["storyHouseholdBudgets"], "gate": "any-published", "capability": "storyHouseholdBudgets" },
    { "path": "/stories/public-finances/", "kind": "evidence", "feeds": ["storyPublicFinances"], "gate": "any-published", "capability": "storyPublicFinances" },
    { "path": "/stories/[slug]/", "kind": "evidence", "feeds": [], "gate": "all-of" },
    { "path": "/feed.xml", "kind": "api", "feeds": [], "evidence": "all", "gate": "none" },
    { "path": "/sitemap.xml", "kind": "api", "feeds": [], "evidence": "all", "gate": "none" },
    { "path": "/robots.txt", "kind": "api", "feeds": [], "gate": "none" },
    { "path": "/about/", "kind": "static", "feeds": [], "gate": "none" },
    { "path": "/editorial-policy/", "kind": "static", "feeds": [], "gate": "none" },
    { "path": "/independence/", "kind": "static", "feeds": [], "gate": "none" },
    { "path": "/contact/", "kind": "static", "feeds": [], "gate": "none" },
    { "path": "/corrections/", "kind": "static", "feeds": [], "gate": "none" }
  ]
}
